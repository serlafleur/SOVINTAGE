{%- comment -%}
  Bannière « Studio » : remplace la bannière éditoriale (svf-hero), jugée trop chargée.
  Une photo, un titre, une ligne, un bouton et un lien. Pas de carrousel, pas de lecture automatique, pas de JavaScript.
  Le fond reprend le gris du studio des photos : la photo se fond dans la bannière.
{%- endcomment -%}
<section class="svf svf-hs" style="--hs-studio: {{ section.settings.studio }};" aria-labelledby="svf-hs-{{ section.id }}">
  <div class="svf-hs-text">
    {%- if section.settings.eyebrow != blank -%}<p class="svf-mono svf-hs-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="svf-hs-title" id="svf-hs-{{ section.id }}">{{ section.settings.heading }}<em>{{ section.settings.heading_em }}</em></h1>
    {%- if section.settings.subheading != blank -%}<p class="svf-hs-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <figure class="svf-hs-fig">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600', sizes: '(min-width: 861px) 50vw, 100vw', alt: section.settings.image.alt, class: 'svf-hs-img' }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'svf-hs-img' }}
    {%- endif -%}
  </figure>
  <div class="svf-hs-ctas">
    {%- if section.settings.cta_label != blank -%}<a class="svf-btn svf-hs-btn" href="{{ section.settings.cta_link | default: '#svf-drop' }}">{{ section.settings.cta_label }}</a>{%- endif -%}
    {%- if section.settings.cta2_label != blank -%}<a class="svf-link" href="{{ section.settings.cta2_link | default: '#svf-silhouettes' }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* Mobile d'abord : titre, photo, bouton. Le bouton reste visible dans le premier écran. */
  .svf.svf-hs{--svf-fg:#1B5C2D;--svf-bg:#F1F5F2;--svf-muted:#3F5C47;background:var(--hs-studio,#D9D7DA);color:var(--svf-fg);display:grid;grid-template-columns:minmax(0,1fr);grid-template-areas:"text" "fig" "ctas";padding-block:16px 28px;overflow:hidden}
  .svf-hs .svf-hs-text{grid-area:text;display:grid;gap:6px;padding-bottom:14px}
  .svf-hs .svf-hs-eyebrow{color:var(--svf-muted)}
  /* Taille calée sur la largeur : « Crépuscule. » tient sur une ligne dès 320 px ; l'espace sous le titre laisse passer le jambage du p */
  .svf-hs .svf-hs-title{font-family:var(--svf-serif);font-weight:400;font-size:clamp(50px,16vw,104px);line-height:.9;letter-spacing:-.035em;margin:0;padding-bottom:.12em}
  .svf-hs .svf-hs-title em{font-style:italic}
  .svf-hs .svf-hs-sub{font-size:15px;line-height:1.45;color:var(--svf-muted);margin:0}
  .svf-hs .svf-hs-fig{grid-area:fig;margin:0 calc(var(--svf-gutter) * -1);height:min(125vw,calc(100svh - 300px));min-height:300px}
  .svf-hs .svf-hs-img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 15%}
  .svf-hs .svf-hs-ctas{grid-area:ctas;display:flex;flex-wrap:wrap;align-items:center;gap:6px 22px;padding-top:18px}
  .svf-hs .svf-hs-btn{flex:1 1 100%;display:flex;align-items:center;justify-content:center;min-height:52px}
  .svf-hs .svf-link{min-height:44px;padding-block:12px;background-position:0 calc(100% - 9px)}
  /* Apparition discrète au chargement */
  .svf-hs .svf-hs-text,.svf-hs .svf-hs-ctas{animation:svfHsIn .9s cubic-bezier(.16,1,.3,1) both}
  .svf-hs .svf-hs-fig{animation:svfHsFade 1.1s ease both}
  .svf-hs .svf-hs-ctas{animation-delay:.15s}
  @keyframes svfHsIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  @keyframes svfHsFade{from{opacity:0}to{opacity:1}}
  @media (prefers-reduced-motion:reduce){.svf-hs .svf-hs-text,.svf-hs .svf-hs-ctas,.svf-hs .svf-hs-fig{animation:none}}

  /* Grand écran : texte à gauche, photo entière à droite, posée en bas sur le gris du studio */
  @media (min-width:861px){
    .svf.svf-hs{grid-template-columns:minmax(0,1fr) minmax(0,1fr);grid-template-rows:1fr auto;grid-template-areas:"text fig" "ctas fig";column-gap:clamp(32px,5vw,80px);height:clamp(560px,calc(100svh - var(--header-height,60px)),900px);padding-block:0}
    .svf-hs .svf-hs-text{align-self:end;gap:12px;padding:48px 0 28px}
    .svf-hs .svf-hs-title{font-size:clamp(96px,11vw,190px)}
    .svf-hs .svf-hs-sub{font-size:17px}
    .svf-hs .svf-hs-ctas{align-self:start;padding:0 0 56px;gap:12px 28px}
    .svf-hs .svf-hs-btn{flex:0 0 auto;padding-inline:30px}
    .svf-hs .svf-hs-fig{margin:0;height:100%;min-height:0}
    .svf-hs .svf-hs-img{object-fit:contain;object-position:50% 100%}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SVF · Bannière studio",
  "tag": "div",
  "class": "svf-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo (portrait, fond studio)" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "N°01 — Collection FW26" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Crépuscule" },
    { "type": "text", "id": "heading_em", "label": "Fin du titre en italique", "default": "." },
    { "type": "text", "id": "subheading", "label": "Ligne sous le titre (facultatif)" },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Explorez la collection" },
    { "type": "text", "id": "cta_link", "label": "Destination du bouton", "default": "#svf-drop" },
    { "type": "text", "id": "cta2_label", "label": "Lien secondaire", "default": "Voir les looks" },
    { "type": "text", "id": "cta2_link", "label": "Destination du lien", "default": "#svf-silhouettes" },
    { "type": "color", "id": "studio", "label": "Fond", "default": "#D9D7DA", "info": "Gardez le gris du fond de la photo pour qu’elle se fonde dans la bannière." }
  ],
  "presets": [{ "name": "SVF · Bannière studio" }]
}
{% endschema %}
