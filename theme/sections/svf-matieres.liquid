<section class="svf svf-mat" data-svf="mat" id="svf-matieres" aria-labelledby="svf-mat-{{ section.id }}">
  <div class="svf-j-grid">
    {%- for block in section.blocks limit: 5 -%}
      {%- assign speeds = '-0.5,0.25,-0.9,0.6,-0.3' | split: ',' -%}
      <figure class="svf-j svf-j-{{ forloop.index }}" data-speed="{{ speeds[forloop.index0] }}" {{ block.shopify_attributes }}>
        <div class="svf-plx">
          {%- render 'svf-tile', kind: block.settings.kind, sig: block.settings.sig, frame: block.settings.frame, wall: block.settings.wall, x: block.settings.x, y: block.settings.y, z: block.settings.zoom, bg: block.settings.bg, image: block.settings.image, alt: block.settings.caption -%}
        </div>
        {%- if forloop.index == 2 and section.settings.overlay != blank -%}<p class="svf-j-title svf-wide">{{ section.settings.overlay }}</p>{%- endif -%}
        {%- if block.settings.caption != blank -%}<figcaption class="svf-tile-cap svf-mono">{{ block.settings.caption }}</figcaption>{%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
  <div class="svf-j-text">
    <p class="svf-mono svf-muted">{{ section.settings.eyebrow }}</p>
    <h2 class="svf-h svf-rv" id="svf-mat-{{ section.id }}">{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2>
    <div class="svf-rv">
      <div class="svf-copy">{{ section.settings.text }}</div>
      {%- if section.settings.link_label != blank -%}<a class="svf-link" href="{{ section.settings.link_url | default: '#svf-drop' }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SVF · Matières",
  "tag": "div",
  "class": "svf-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "overlay", "label": "Mot sur la grande image", "default": "Matières" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "02 / Matières & détails" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le détail" },
    { "type": "text", "id": "heading_em", "label": "Titre (italique)", "default": "change tout." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Des textures à regarder de près. Nos Cravates Signatures en fausse fourrure donnent une nouvelle place à cet accessoire.</p>" },
    { "type": "text", "id": "link_label", "label": "Lien", "default": "Explorer les pièces" },
    { "type": "text", "id": "link_url", "label": "Destination du lien", "default": "#svf-drop" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Visuel",
      "settings": [
        { "type": "select", "id": "kind", "label": "Type", "default": "tie", "options": [ { "value": "tie", "label": "Cravate sur un mur" }, { "value": "macro", "label": "Gros plan" }, { "value": "image", "label": "Photo" } ] },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "select", "id": "sig", "label": "Cravate", "default": "ombre", "options": [ { "value": "ombre", "label": "Ombre" }, { "value": "brume", "label": "Brume" }, { "value": "sable", "label": "Sable" }, { "value": "neige", "label": "Neige" } ] },
        { "type": "range", "id": "frame", "label": "Angle de vue", "min": 1, "max": 72, "step": 1, "default": 1 },
        { "type": "select", "id": "wall", "label": "Mur", "default": "green", "options": [
          { "value": "green", "label": "Vert" }, { "value": "char", "label": "Anthracite" }, { "value": "tobacco", "label": "Tabac" }, { "value": "oxblood", "label": "Bordeaux" }, { "value": "slate", "label": "Ardoise" }, { "value": "olive", "label": "Olive" }, { "value": "stone", "label": "Pierre" }, { "value": "sand", "label": "Sable" }, { "value": "mist", "label": "Brume claire" } ] },
        { "type": "header", "content": "Gros plan" },
        { "type": "range", "id": "x", "label": "Point visé (horizontal)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Point visé (vertical)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "zoom", "label": "Zoom", "min": 1.5, "max": 5, "step": 0.1, "default": 3 },
        { "type": "color", "id": "bg", "label": "Fond", "default": "#1A1917" },
        { "type": "text", "id": "caption", "label": "Légende" }
      ]
    }
  ],
  "presets": [{
    "name": "SVF · Matières",
    "blocks": [
      { "type": "tile", "settings": { "kind": "tie", "sig": "brume", "frame": 8, "wall": "stone", "caption": "Signature Brume" } },
      { "type": "tile", "settings": { "kind": "tie", "sig": "ombre", "frame": 1, "wall": "green", "caption": "Signature Ombre · endroit" } },
      { "type": "tile", "settings": { "kind": "macro", "sig": "ombre", "frame": 1, "x": 49, "y": 12, "zoom": 3.6, "bg": "#1A1917", "caption": "Trois perles" } },
      { "type": "tile", "settings": { "kind": "macro", "sig": "brume", "frame": 37, "x": 50, "y": 48, "zoom": 2.6, "bg": "#24272A", "caption": "Envers jacquard" } },
      { "type": "tile", "settings": { "kind": "tie", "sig": "sable", "frame": 66, "wall": "sand", "caption": "Signature Sable" } }
    ]
  }]
}
{% endschema %}
