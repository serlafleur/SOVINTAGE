{%- comment -%}
  Bannière éditoriale : fond studio (même gris que les photos), titre placé derrière les photos
  (les photos passent en « darken » : le gris disparaît, les silhouettes passent devant les lettres),
  looks qui défilent en rideau au centre, deux gros plans sur les côtés.
{%- endcomment -%}
{%- assign slides = section.blocks | where: 'type', 'slide' -%}
<section class="svf svf-hero" data-svf="hero" style="--svf-studio: {{ section.settings.studio }}; --svf-dur: {{ section.settings.autoplay }};" aria-labelledby="svf-hero-{{ section.id }}">
  <div class="svf-ed">
    <div class="svf-ed-top">
      <span class="svf-mono">{{ section.settings.top_left }}</span>
      <span class="svf-mono svf-ed-mid">{{ section.settings.top_center }}</span>
      <span class="svf-mono">{{ section.settings.top_right }}</span>
    </div>
    <div class="svf-ed-grid">
      <h1 class="svf-ed-title" id="svf-hero-{{ section.id }}" aria-label="{{ section.settings.heading | append: section.settings.heading_em | escape }}">{{ section.settings.heading }}<em>{{ section.settings.heading_em }}</em></h1>

      <figure class="svf-ed-side svf-ed-l" style="--d:-16">
        <div class="svf-ed-img">
          {%- if section.settings.image_a != blank -%}
            {{ section.settings.image_a | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '450, 700, 900', sizes: '(min-width: 861px) 22vw, 45vw', alt: section.settings.image_a.alt }}
          {%- else -%}
            <img src="{% render 'svf-frame-url', sig: 'ombre', frame: 1 %}" alt="" width="800" height="1200">
          {%- endif -%}
        </div>
        <figcaption class="svf-mono"><b>{{ section.settings.caption_a_title }}</b><br>{{ section.settings.caption_a_text | newline_to_br }}</figcaption>
      </figure>

      <figure class="svf-ed-main">
        <div class="svf-ed-slides" role="button" tabindex="0" aria-label="Look suivant">
          {%- for b in slides -%}
            <div class="svf-ed-slide{% if forloop.first %} is-on{% endif %}" data-look="{{ b.settings.look | escape }}" data-desc="{{ b.settings.desc | escape }}" {{ b.shopify_attributes }}>
              {%- if b.settings.image != blank -%}
                {%- if forloop.first -%}
                  {{ b.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '700, 1000, 1400', sizes: '(min-width: 861px) 40vw, 100vw', alt: b.settings.image.alt }}
                {%- else -%}
                  {{ b.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700, 1000, 1400', sizes: '(min-width: 861px) 40vw, 100vw', alt: b.settings.image.alt }}
                {%- endif -%}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'svf-ed-ph' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        <figcaption class="svf-ed-cap">
          <span class="svf-mono" data-ed-num>01 / {{ slides.size | prepend: '0' | slice: -2, 2 }}</span>
          <span class="svf-ed-look" data-ed-look>{{ slides.first.settings.look }}</span>
          <span class="svf-ed-nav"><button type="button" data-ed-prev aria-label="Look précédent">←</button><button type="button" data-ed-next aria-label="Look suivant">→</button></span>
          <span class="svf-mono svf-ed-desc" data-ed-desc>{{ slides.first.settings.desc }}</span>
          <span class="svf-ed-prog" aria-hidden="true"><span data-ed-bar></span></span>
        </figcaption>
      </figure>

      <figure class="svf-ed-side svf-ed-r" style="--d:14">
        <div class="svf-ed-img">
          {%- if section.settings.image_b != blank -%}
            {{ section.settings.image_b | image_url: width: 900 | image_tag: loading: 'eager', widths: '450, 700, 900', sizes: '(min-width: 861px) 22vw, 45vw', alt: section.settings.image_b.alt }}
          {%- else -%}
            <img src="{% render 'svf-frame-url', sig: 'sable', frame: 1 %}" alt="" width="800" height="1200">
          {%- endif -%}
        </div>
        <figcaption class="svf-mono"><b>{{ section.settings.caption_b_title }}</b><br>{{ section.settings.caption_b_text | newline_to_br }}</figcaption>
      </figure>
    </div>
    <div class="svf-ed-foot">
      <p class="svf-ed-lede"><em>{{ section.settings.lede_em }}</em> {{ section.settings.lede }}</p>
      <div class="svf-ed-ctas">
        {%- if section.settings.cta_label != blank -%}<a class="svf-btn" href="{{ section.settings.cta_link | default: '#svf-drop' }}">{{ section.settings.cta_label }}</a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="svf-link" href="{{ section.settings.cta2_link | default: '#svf-silhouettes' }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SVF · Bannière éditoriale",
  "tag": "div",
  "class": "svf-section",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Textes" },
    { "type": "text", "id": "top_left", "label": "Mention haut gauche", "default": "N°01 — Collection FW26" },
    { "type": "text", "id": "top_center", "label": "Mention haut centre", "default": "Collection Crépuscule" },
    { "type": "text", "id": "top_right", "label": "Mention haut droite", "default": "Lookbook · Crépuscule" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Crépuscule" },
    { "type": "text", "id": "heading_em", "label": "Fin du titre en italique", "default": "." },
    { "type": "text", "id": "lede_em", "label": "Accroche (italique)", "default": "Une cravate, une présence." },
    { "type": "text", "id": "lede", "label": "Accroche (suite)", "default": "La fausse fourrure bouscule les codes et dessine une autre silhouette." },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Explorer le drop" },
    { "type": "text", "id": "cta_link", "label": "Destination du bouton", "default": "#svf-drop" },
    { "type": "text", "id": "cta2_label", "label": "Lien secondaire", "default": "Voir les looks" },
    { "type": "text", "id": "cta2_link", "label": "Destination du lien", "default": "#svf-silhouettes" },
    { "type": "header", "content": "Gros plans" },
    { "type": "image_picker", "id": "image_a", "label": "Gros plan gauche" },
    { "type": "text", "id": "caption_a_title", "label": "Légende gauche · titre", "default": "(A) Signature Ombre" },
    { "type": "textarea", "id": "caption_a_text", "label": "Légende gauche · texte", "default": "Fausse fourrure noir profond,\ntrois perles à l’encolure" },
    { "type": "image_picker", "id": "image_b", "label": "Gros plan droit" },
    { "type": "text", "id": "caption_b_title", "label": "Légende droite · titre", "default": "(B) Signature Sable" },
    { "type": "textarea", "id": "caption_b_text", "label": "Légende droite · texte", "default": "Blond miel, mèches longues,\nenvers jacquard ivoire" },
    { "type": "header", "content": "Mise en scène" },
    { "type": "color", "id": "studio", "label": "Fond studio", "default": "#D9D7DA", "info": "Gardez le gris du fond de vos photos pour que les images se fondent dans la bannière." },
    { "type": "range", "id": "autoplay", "label": "Durée par look", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (portrait 2:3)" },
        { "type": "text", "id": "look", "label": "Nom du look", "default": "Look Florian" },
        { "type": "text", "id": "desc", "label": "Description", "default": "Blazer bordeaux, manteau en fausse fourrure, Signature Ombre" }
      ]
    }
  ],
  "presets": [{ "name": "SVF · Bannière éditoriale", "blocks": [ { "type": "slide" }, { "type": "slide" } ] }]
}
{% endschema %}
